# v2 — production since 2026-09-19 00:58 UTC (and again since 2026-09-23 13:45 UTC, after the v3 rollback).
# Known weak spot: MAXREQ (96) is above the graph ceiling (60). Batches of 61-96 run without a CUDA graph at
# ~174 ms per step, ~13 tok/s per user (docs/results.md, 2026-09-22 eval). MAXREQ=60 would make the excess
# wait in the queue instead, and also shrink the KDA verify-snapshot buffer by ~7.4 GB/GPU
# (docs/memory-budget.md) — not yet tried in production.
MEMF=0.75
CHUNK=4096
CONTEXT_LENGTH=524288
CONC=60
MAXREQ=96
ADAPTIVE_SPEC=adaptive_spec.json
SPEC_ARGS="--speculative-algorithm EAGLE --speculative-num-steps 5 --speculative-eagle-topk 1 --speculative-num-draft-tokens 6 --speculative-adaptive"
